# Primary Backend API Base URL (Render Cloud deployment or local server)
VITE_API_URL=https://bath-sevok-server-nlbg.onrender.com

# Alternative aliases supported by client
VITE_API_BACKEND_URL=https://bath-sevok-server-nlbg.onrender.com
VITE_API_BASE_URL=https://bath-sevok-server-nlbg.onrender.com

# Realtime WebSocket stream (Socket.IO)
VITE_WS_URL=wss://bath-sevok-server-nlbg.onrender.com

# Data source mode: 'live' (prioritize live backend) | 'mock' (local demo fallback)
VITE_DATA_SOURCE=live

# Initial Map Geographic Coordinates (Assam Central Corridor)
VITE_MAP_DEFAULT_CENTER_LAT=26.1500
VITE_MAP_DEFAULT_CENTER_LNG=91.8000
VITE_MAP_DEFAULT_ZOOM=8.5

# Optional Client-side OpenRouteService key (if routing directly without backend proxy)
VITE_OPENROUTESERVICE_API_KEY=

